print("SIMPLE CALCULATOR")

print("1. Addition")
print("2. Subtraction")
print("3. Multiplication")
print("4. Division")

choice = input("Choose: ")

num1 = float(input("First number: "))
num2 = float(input("Second number: "))

if choice == "1":
    print("Answer:", num1 + num2)
elif choice == "2":
    print("Answer:", num1 - num2)
elif choice == "3":
    print("Answer:", num1 * num2)
elif choice == "4":
    if num2 != 0:
        print("Answer:", num1 / num2)
    else:
        print("Cannot divide by zero.")
else:
    print("Invalid choice.")
